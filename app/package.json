{
  "name": "frontend-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Learn HTML, CSS, JavaScript and React: teach, example, task, your code, graded out of 10.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch-path=server --watch-path=content server/index.js",
    "dev:web": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@vitejs/plugin-react": "^6.1.2",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "codemirror": "^6.0.2",
    "concurrently": "^10.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "sucrase": "^3.35.1",
    "vite": "^8.3.5"
  }
}
